 FSP_API NTSTATUS FspFileSystemNotify(FSP_FILE_SYSTEM *FileSystem,
     FSP_FSCTL_NOTIFY_INFO *NotifyInfo, SIZE_T Size);
+/**
+ * Flush the cached data of a file and wait for the flush to complete.
+ *
+ * Unless a file system sets FlushAndPurgeOnCleanup, Windows may keep data written
+ * to a file in its cache after the file has been closed; the data reaches the file
+ * system later as Write requests. FspFileSystemFlushByName asks the FSD to write the
+ * cached data of the named file now. It returns after the FSD has received the
+ * responses to the resulting Write requests, with the status of the flush. It does
+ * not purge the cache and does not send a Flush request to the file system.
+ *
+ * When this function returns STATUS_SUCCESS, all data of the file that was dirty in
+ * the cache when the flush started has been delivered to the file system by Write
+ * requests that completed successfully. A file that has no cached data, including a
+ * file that is not open, and a directory flush successfully without Write requests.
+ * On case-insensitive file systems the name is matched without regard to case.
+ *
+ * The Write requests that the flush produces are serviced by the dispatcher threads.
+ * This function must therefore not be called from a dispatcher thread (it returns
+ * STATUS_POSSIBLE_DEADLOCK), and the caller must not hold locks that the file system
+ * needs to service Write requests.
+ *
+ * @param FileSystem
+ *     The file system object.
+ * @param FileName
+ *     The absolute name of the file within the file system (e.g. \\dir\\file).
+ * @param Timeout
+ *     Maximum time to wait in milliseconds, or INFINITE. If the time expires, this
+ *     function returns STATUS_IO_TIMEOUT while the flush continues in the FSD; its
+ *     outcome is then unknown.
+ * @return
+ *     STATUS_SUCCESS or error code. The error code STATUS_IO_TIMEOUT means that the
+ *     flush did not complete in time. The error code STATUS_NOT_IMPLEMENTED means
+ *     that the FSD does not support this operation.
+ */
+FSP_API NTSTATUS FspFileSystemFlushByName(FSP_FILE_SYSTEM *FileSystem,
+    PWSTR FileName, ULONG Timeout);
 /**
  * Get the current operation context.
  *
diff --git a/src/dll/fs.c b/src/dll/fs.c
index 8dfd46f8..b448c610 100644
--- a/src/dll/fs.c
+++ b/src/dll/fs.c
@@ -519,6 +519,20 @@ FSP_API NTSTATUS FspFileSystemNotify(FSP_FILE_SYSTEM *FileSystem,
     return FspFsctlNotify(FileSystem->VolumeHandle, NotifyInfo, Size);
 }
 
+FSP_API NTSTATUS FspFileSystemFlushByName(FSP_FILE_SYSTEM *FileSystem,
+    PWSTR FileName, ULONG Timeout)
+{
+    /*
+     * The flush produces Write requests that the dispatcher threads service, and it
+     * waits for the FileNode resources that a request being serviced owns. A call from
+     * a dispatcher thread can therefore deadlock; refuse it.
+     */
+    if (0 != FspFileSystemGetOperationContext())
+        return STATUS_POSSIBLE_DEADLOCK;
+
+    return FspFsctlFlushByName(FileSystem->VolumeHandle, FileName, Timeout);
+}
