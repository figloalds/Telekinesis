+FSP_API NTSTATUS FspFsctlFlushByName(HANDLE VolumeHandle,
+    PWSTR FileName, ULONG Timeout)
+{
+    NTSTATUS Result = STATUS_SUCCESS;
+    FSP_FSCTL_FLUSH_BY_NAME_INFO *FlushInfo = 0;
+    SIZE_T FileNameSize, Size;
+    DWORD Bytes = 0;
+
+    FileNameSize = lstrlenW(FileName) * sizeof(WCHAR);
+    if (FSP_FSCTL_TRANSACT_PATH_SIZEMAX < FileNameSize)
+        return STATUS_OBJECT_NAME_INVALID;
+
+    Size = sizeof *FlushInfo + FileNameSize;
+    FlushInfo = MemAlloc(Size);
+    if (0 == FlushInfo)
+        return STATUS_INSUFFICIENT_RESOURCES;
+
+    FlushInfo->Timeout = Timeout;
+    FlushInfo->Flags = 0;
+    memcpy(FlushInfo->FileNameBuf, FileName, FileNameSize);
+
+    /* the FSD completes this request before it returns; it never pends it */
+    if (!DeviceIoControl(VolumeHandle,
+        FSP_FSCTL_FLUSH_BY_NAME,
+        FlushInfo, (DWORD)Size, 0, 0,
+        &Bytes, 0))
+    {
+        Result = FspNtStatusFromWin32(GetLastError());
+        goto exit;
+    }
+
+exit:
+    MemFree(FlushInfo);
+
+    return Result;
+}
