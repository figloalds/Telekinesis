import { ScrollView, TextEdit, AboutSlint, Palette } from "std-widgets.slint";
export struct FolderRow { state: string, label: string, mount: string, running: bool, starting: bool, error: string }
export struct RemoteRow { repo: string, label: string }
export struct PeerRow { endpoint: string, online: bool }
global Theme {
    out property <color> background: #0e131b;
    out property <color> panel: #161d28;
    out property <color> line: #263040;
    out property <color> ink: #e6eaf0;
    out property <color> muted: #97a1b2;
    out property <color> accent: #7f9fff;
}
component Label inherits Text { color: Theme.ink; font-size: 14px; vertical-alignment: center; overflow: elide; }
component Muted inherits Label { color: Theme.muted; font-size: 12px; }
component ActionButton inherits Rectangle {
    in property <string> text;
    in property <bool> primary;
    in property <bool> quiet;
    in property <bool> enabled: true;
    callback clicked();
    forward-focus: focus;
    height: 34px;
    min-width: caption.preferred-width + 24px;
    border-radius: 7px;
    border-width: 1px;
    border-color: focus.has-focus ? Theme.accent : root.primary ? Theme.accent : root.quiet ? transparent : Theme.line;
    background: !root.enabled ? Theme.panel : touch.pressed ? #30416a : touch.has-hover ? #253047 : root.primary ? Theme.accent : root.quiet ? transparent : Theme.panel;
    opacity: root.enabled ? 1 : 0.45;
    caption := Label { text: root.text; color: root.primary ? #ffffff : Theme.ink; horizontal-alignment: center; font-size: 13px; font-weight: 600; }
    focus := FocusScope {
        enabled: root.enabled;
        key-pressed(event) => {
            if event.text == "\n" || event.text == " " { root.clicked(); return accept; }
            return reject;
        }
    }
    touch := TouchArea { enabled: root.enabled; mouse-cursor: pointer; clicked => { focus.focus(); root.clicked(); } }
    accessible-role: button;
    accessible-enabled: root.enabled;
    accessible-label: root.text;
    accessible-action-default => { if root.enabled { root.clicked(); } }
}
component Field inherits Rectangle {
    in-out property <string> text <=> input.text;
    in property <string> placeholder;
    in property <bool> enabled: true;
    callback edited(string);
    forward-focus: input;
    height: 38px;
    border-radius: 7px;
    border-width: 1px;
    border-color: input.has-focus ? Theme.accent : Theme.line;
    background: Theme.background;
    if input.text == "": Muted { x: 12px; width: parent.width - 24px; text: root.placeholder; }
    input := TextInput {
        x: 12px; width: parent.width - 24px; height: parent.height;
        color: Theme.ink; font-size: 14px; vertical-alignment: center;
        single-line: true; enabled: root.enabled;
        selection-background-color: #3558a1; selection-foreground-color: #ffffff;
        edited => { root.edited(self.text); }
        accessible-label: root.placeholder;
    }
}
component Card inherits Rectangle { background: Theme.panel; border-color: Theme.line; border-width: 1px; border-radius: 11px; }
component Stat inherits Card {
    in property <string> title;
    in property <string> value;
    in property <string> detail;
    height: 98px;
    VerticalLayout { padding: 16px; spacing: 5px;
        Muted { text: root.title; }
        Label { text: root.value; font-size: 23px; font-weight: 600; }
        Muted { text: root.detail; }
    }
}
component FolderIcon inherits Rectangle {
    width: 30px;
    Rectangle { y: (parent.height - 26px) / 2; width: 30px; height: 26px; border-radius: 5px; background: #1b2a52;
        Rectangle { x: 7px; y: 6px; width: 8px; height: 5px; background: #ffcf60; border-radius: 1px; }
        Rectangle { x: 7px; y: 9px; width: 16px; height: 12px; background: #ffc44d; border-radius: 2px; }
    }
}
export component AppWindow inherits Window {
    title: "Telekinesis — Virtual folders";
    preferred-width: 1320px; preferred-height: 820px;
    min-width: 1040px; min-height: 680px;
    background: Theme.background;
    init => { Palette.color-scheme = ColorScheme.dark; }
    default-font-family: "Segoe UI";
    in property <string> config-path;
    in-out property <string> status: "Connecting to the local orchestrator…";
    in property <bool> status-error;
    in property <bool> connected;
    in property <bool> busy;
    in property <string> listen-address;
    in property <string> host-name;
    in property <int> folder-count;
    in property <int> mounted-count;
    in property <int> online-count;
    in property <[FolderRow]> folders;
    in property <[RemoteRow]> remote-folders;
    in property <[PeerRow]> peer-rows;
    in-out property <string> selected-state;
    in-out property <string> selected-repo;
    in-out property <string> selected-label;
    in-out property <string> pairing-code;
    in-out property <string> dialog;
    in-out property <string> endpoint;
    in-out property <string> folder-name;
    in-out property <string> mount-path;
    in-out property <string> remote-mount;
    in-out property <string> code;
    in-out property <string> search;
    in property <string> remote-message: "Connect to an orchestrator, then browse its folders.";
    callback search-folders(string);
    callback remote-changed();
    callback refresh();
    callback create-folder(string, string);
    callback start-folder(string);
    callback stop-folder(string);
    callback configure-mount(string, string);
    callback pair(string, string);
    callback remote-list(string);
    callback receive-folder(string, string, string, string);
    callback reset-code();
    callback unpair(string);
    callback peers();
    callback shutdown();
    private property <bool> interactive: root.dialog == "" && !root.busy;
    private property <length> name-column: 190px;
    forward-focus: keyboard;
    keyboard := FocusScope {

        key-pressed(event) => {
            if event.text == Key.Escape && root.dialog != "" && !root.busy { root.dialog = ""; return accept; }
            return reject;
        }
    HorizontalLayout { spacing: 0px;
        Rectangle { width: 248px; background: #0a1020;
            VerticalLayout { padding: 14px; spacing: 10px;
                HorizontalLayout { padding: 8px; spacing: 10px; height: 44px;
                    Rectangle { width: 28px; height: 28px; background: #4778ed; border-radius: 8px; Image { source: @image-url("anchor.svg"); x: 5px; y: 5px; width: 18px; height: 18px; } }
                    Label { text: "Telekinesis"; font-weight: 700; font-size: 18px; }
                }
                Rectangle { height: 38px; background: #2b3141; border-radius: 8px;
                    HorizontalLayout { padding-left: 12px; padding-right: 12px; spacing: 8px;
                        Label { text: "Virtual folders"; }
                        Muted { text: root.folder-count; horizontal-alignment: right; }
                    }
                }
                Muted { text: "Remote orchestrators"; height: 30px; color: #8393b3; }
                ScrollView { vertical-stretch: 1;
                    VerticalLayout { spacing: 5px;
                        for peer in root.peer-rows: ActionButton { min-width: 0px; text: (peer.online ? "●  " : "○  ") + peer.endpoint; quiet: true; enabled: root.interactive;
                            clicked => { root.endpoint = peer.endpoint; root.selected-repo = ""; root.dialog = "connect"; root.remote-list(peer.endpoint); }
                        }
                        if root.peer-rows.length == 0: Muted { text: "No remotes connected"; height: 28px; }
                        ActionButton { text: "+  Connect orchestrator"; quiet: true; enabled: root.interactive; clicked => { root.dialog = "connect"; } }
                        Rectangle { vertical-stretch: 1; }
                    }
                }
                ActionButton { text: "Host settings"; quiet: true; enabled: root.interactive; clicked => { root.dialog = "host"; } }
                Card { height: 140px; background: #0a1020;
                    VerticalLayout { padding: 13px; spacing: 5px;
                        Label { text: "Host · " + root.host-name; font-size: 12px; font-weight: 600; }
                        HorizontalLayout { Muted { text: "Status"; } Label { text: root.connected ? "● Running" : "○ Offline"; color: root.connected ? #5fd0a6 : Theme.muted; horizontal-alignment: right; font-size: 12px; } }
                        HorizontalLayout { Muted { text: "Listening"; } Muted { text: root.listen-address; horizontal-alignment: right; } }
                        HorizontalLayout { Muted { text: "Mounted"; } Muted { text: root.mounted-count + " of " + root.folder-count; horizontal-alignment: right; } }
                        HorizontalLayout { Muted { text: "Storage"; } Muted { text: "Not reported"; horizontal-alignment: right; } }
                    }
                }
            }
        }
        VerticalLayout { spacing: 0px;
            Rectangle { height: 158px; background: Theme.panel;
                VerticalLayout { padding-top: 20px; padding-bottom: 15px; padding-left: 24px; padding-right: 24px; spacing: 10px;
                    Label { text: "Virtual folders"; font-size: 20px; font-weight: 600; }
                    Field { placeholder: "Search folders"; text <=> root.search; enabled: root.dialog == ""; edited(text) => { root.search-folders(text); } }
                    HorizontalLayout { spacing: 10px;
                        ActionButton { text: "Connect remote"; enabled: root.interactive; clicked => { root.dialog = "connect"; } }
                        ActionButton { text: "New folder"; primary: true; enabled: root.interactive; clicked => { root.folder-name = ""; root.mount-path = ""; root.dialog = "create"; } }
                        Rectangle { horizontal-stretch: 1; }
                        ActionButton { text: "Refresh"; quiet: true; enabled: root.interactive; clicked => { root.refresh(); } }
                    }
                }
                Rectangle { y: parent.height - 1px; height: 1px; background: Theme.line; }
            }
            VerticalLayout { padding: 24px; spacing: 18px;
                HorizontalLayout { spacing: 12px;
                    Stat { min-width: 0px; preferred-width: 0px; horizontal-stretch: 1; title: "Storage used"; value: "—"; detail: "Storage usage is not reported yet"; }
                    Stat { min-width: 0px; preferred-width: 0px; horizontal-stretch: 1; title: "Folders mounted"; value: root.mounted-count + " / " + root.folder-count; detail: "On this host"; }
                    Stat { min-width: 0px; preferred-width: 0px; horizontal-stretch: 1; title: "Orchestrators online"; value: root.online-count + " / " + root.peer-rows.length; detail: "Connected remote hosts"; }
                }
                Card { min-height: 104px; preferred-height: root.folders.length == 0 ? 260px : 46px + root.folders.length * 58px; vertical-stretch: 0;
                    VerticalLayout { spacing: 0px; padding: 1px;
                        HorizontalLayout { height: 42px; padding-left: 16px; padding-right: 16px; spacing: 14px;
                            Muted { text: "Name"; width: root.name-column; }
                            Muted { text: "Mount point"; horizontal-stretch: 1.2; }
                            Muted { text: "Status"; width: 118px; }
                            Muted { text: "Actions"; width: 186px; horizontal-alignment: right; }
                        }
                        Rectangle { height: 1px; background: Theme.line; }
                        if root.folders.length > 0: ScrollView {
                            VerticalLayout { spacing: 0px;
                                for folder in root.folders: Rectangle { height: 58px; background: row-hover.has-hover ? #1b2432 : transparent;
                                    row-hover := TouchArea {}
                                    HorizontalLayout { padding-left: 16px; padding-right: 16px; padding-top: 12px; padding-bottom: 12px; spacing: 14px;
                                        HorizontalLayout { width: root.name-column; spacing: 10px; alignment: start;
                                            FolderIcon {}
                                            Label { text: folder.label; font-weight: 600; horizontal-stretch: 1; }
                                        }
                                        Label { text: folder.mount == "" ? "No mount point" : folder.mount; font-family: "Consolas"; font-size: 12px; horizontal-stretch: 1.2; }
                                        Rectangle { width: 118px;
                                          Rectangle { y: (parent.height - 24px) / 2; width: parent.width; height: 24px; border-radius: 12px;
                                            background: folder.error != "" ? #43262a : folder.running ? #12342a : #222a37;
                                            Label { text: folder.starting ? "◌ Starting" : folder.error != "" ? "! Needs attention" : folder.running ? (folder.mount == "" ? "● Headless" : "● Mounted") : "○ Not mounted"; color: folder.error != "" ? #ff9d96 : folder.running ? #5fd0a6 : Theme.muted; font-size: 11px; horizontal-alignment: center; }
                                          }
                                        }
                                        HorizontalLayout { width: 186px; spacing: 6px;
                                            ActionButton { text: folder.starting ? "Cancel" : folder.running ? (folder.mount == "" ? "Stop" : "Unmount") : (folder.mount == "" ? "Start" : "Mount"); enabled: root.interactive;
                                                clicked => { if folder.running || folder.starting { root.stop-folder(folder.state); } else { root.start-folder(folder.state); } }
                                            }
                                            ActionButton { text: "Change path"; enabled: root.interactive;
                                                clicked => { root.selected-state = folder.state; root.selected-label = folder.label; root.mount-path = folder.mount; root.dialog = (folder.running || folder.starting) ? "stop-first" : "mount"; }
                                            }
                                        }
                                    }
                                    Rectangle { y: parent.height - 1px; height: 1px; background: Theme.line; }
                                }
                                Rectangle { vertical-stretch: 1; }
                            }
                        }
                        if root.folders.length == 0: VerticalLayout { padding: 40px; spacing: 12px; alignment: center;
                            Label { text: root.search != "" ? "No folders match your search" : "Your folders, all in one place"; font-size: 18px; font-weight: 600; horizontal-alignment: center; }
                            Muted { text: root.search != "" ? "Try another name or mount path." : "Create a virtual folder or connect a remote orchestrator to get started."; horizontal-alignment: center; }
                            Rectangle { height: 12px; }
                            HorizontalLayout { alignment: center;
                                ActionButton { text: root.search != "" ? "Clear search" : "Create your first folder"; primary: true; enabled: root.interactive;
                                    clicked => { if root.search != "" { root.search = ""; root.search-folders(""); } else { root.folder-name = ""; root.mount-path = ""; root.dialog = "create"; } }
                                }
                            }
                        }
                    }
                }
                Rectangle { vertical-stretch: 1; }
                HorizontalLayout { height: 34px; spacing: 12px;
                    Label { text: root.busy ? "Working…" : root.status; color: root.status-error ? #ff9d96 : Theme.muted; font-size: 12px; horizontal-stretch: 1; }
                    ActionButton { text: "Details"; quiet: true; enabled: root.dialog == ""; clicked => { root.dialog = "details"; } }
                }
            }
        }
    }
    if root.dialog != "": Rectangle {
        background: #050913bb;
        TouchArea { clicked => { if !root.busy { root.dialog = ""; } } }
        Card {
            x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
            width: root.dialog == "connect" ? 600px : 510px;
            height: self.preferred-height;
            TouchArea {}
            VerticalLayout { padding: 24px; spacing: 14px;
                HorizontalLayout {
                    Label { text: root.dialog == "create" ? "New virtual folder" : root.dialog == "mount" || root.dialog == "stop-first" ? "Change mount point" : root.dialog == "connect" ? "Connect remote orchestrator" : root.dialog == "host" ? "Host settings" : root.dialog == "shutdown" ? "Shut down host" : "Activity details"; font-size: 20px; font-weight: 600; }
                    ActionButton { width: 34px; text: "×"; quiet: true; enabled: !root.busy; clicked => { root.dialog = ""; } }
                }
                if root.dialog == "create" || root.dialog == "mount": VerticalLayout { spacing: 10px;
                    Muted { text: root.dialog == "create" ? "Create a folder on this host and choose where it appears on disk." : "Choose a new mount point for “" + root.selected-label + "”."; wrap: word-wrap; }
                    if root.dialog == "create": VerticalLayout { spacing: 6px;
                        Label { text: "Folder name"; }
                        Field { placeholder: "Project files"; text <=> root.folder-name; enabled: !root.busy; }
                    }
                    Label { text: "Mount point"; }
                    Field { placeholder: "e.g. C:\\Telekinesis\\projects"; text <=> root.mount-path; enabled: !root.busy; }
                    Muted { text: root.dialog == "create" ? "Leave empty to use the default mount directory. The folder mounts immediately." : "Leave empty to run without a filesystem mount. Start the folder after saving."; wrap: word-wrap; }
                    HorizontalLayout { alignment: end; spacing: 8px;
                        ActionButton { text: "Cancel"; enabled: !root.busy; clicked => { root.dialog = ""; } }
                        ActionButton { text: root.dialog == "create" ? "Create & mount" : "Save mount point"; primary: true; enabled: !root.busy && (root.dialog != "create" || root.folder-name != ""); clicked => { if root.dialog == "create" { root.create-folder(root.folder-name, root.mount-path); } else { root.configure-mount(root.selected-state, root.mount-path); } } }
                    }
                }
                if root.dialog == "stop-first": VerticalLayout { spacing: 16px;
                    Label { text: "Unmount “" + root.selected-label + "” before changing its path. Close any open files in this folder first."; wrap: word-wrap; }
                    ActionButton { text: "Stop folder to change path"; primary: true; enabled: !root.busy; clicked => { root.stop-folder(root.selected-state); } }
                }
                if root.dialog == "connect": VerticalLayout { spacing: 9px;
                    Muted { text: "Pair with another host to browse and receive its shared folders."; }
                    Label { text: "Orchestrator address"; }
                    Field { placeholder: "ws://host:43180 or wss://host"; text <=> root.endpoint; enabled: !root.busy; edited(_) => { root.remote-changed(); } }
                    Label { text: "Remote pairing code"; }
                    Field { placeholder: "Enter the code from the remote host"; text <=> root.code; enabled: !root.busy; }
                    HorizontalLayout { spacing: 8px;
                        ActionButton { text: "Pair"; primary: true; enabled: !root.busy && root.endpoint != "" && root.code != ""; clicked => { root.pair(root.endpoint, root.code); } }
                        ActionButton { text: "Browse folders"; enabled: !root.busy && root.endpoint != ""; clicked => { root.remote-list(root.endpoint); } }
                        ActionButton { text: "Disconnect"; enabled: !root.busy && root.endpoint != ""; clicked => { root.unpair(root.endpoint); } }
                    }
                    Muted { text: root.remote-message; wrap: word-wrap; }
                    ScrollView { height: 110px;
                        VerticalLayout { spacing: 5px;
                            for remote in root.remote-folders: ActionButton { min-width: 0px; text: (root.selected-repo == remote.repo ? "●  " : "○  ") + remote.label; enabled: !root.busy; clicked => { root.selected-repo = remote.repo; root.selected-label = remote.label; } }
                            Rectangle { vertical-stretch: 1; }
                        }
                    }
                    Field { placeholder: "Local mount point (optional)"; text <=> root.remote-mount; enabled: !root.busy; }
                    ActionButton { min-width: 0px; text: root.selected-repo == "" ? "Select a folder to receive" : "Receive & mount “" + root.selected-label + "”"; primary: true; enabled: !root.busy && root.selected-repo != ""; clicked => { root.receive-folder(root.endpoint, root.selected-repo, root.selected-label, root.remote-mount); } }
                }
                if root.dialog == "host": VerticalLayout { spacing: 12px;
                    Muted { text: "Configuration"; }
                    Label { text: root.config-path; wrap: word-wrap; }
                    Muted { text: "Generate a code to pair another host with this orchestrator. A new code replaces the old one; existing peers must pair again."; wrap: word-wrap; }
                    ActionButton { text: "Generate new pairing code"; enabled: !root.busy; clicked => { root.reset-code(); } }
                    TextEdit { text: root.pairing-code; read-only: true; height: 60px; }
                    Muted { text: "Closing this window leaves the daemon and mounts running."; wrap: word-wrap; }
                    HorizontalLayout { spacing: 8px;
                        ActionButton { text: "About Slint"; clicked => { about.show(); } }
                        ActionButton { text: "Shut down daemon"; enabled: !root.busy && root.connected; clicked => { root.dialog = "shutdown"; } }
                    }
                }
                if root.dialog == "shutdown": VerticalLayout { spacing: 16px;
                    Label { text: "Shut down this host? All running folders will stop and their mounts will become unavailable."; wrap: word-wrap; }
                    ActionButton { text: "Shut down daemon"; enabled: !root.busy; clicked => { root.shutdown(); } }
                }
                if root.dialog == "details": TextEdit { text: root.status; read-only: true; height: 180px; }
                if root.dialog != "details": Label { text: root.busy ? "Working…" : root.status; color: root.status-error ? #ff9d96 : Theme.muted; font-size: 12px; wrap: word-wrap; }
            }
        }
    }
    }
    about := PopupWindow { VerticalLayout { AboutSlint {} } }
}
