import { Button, LineEdit, ScrollView, VerticalBox, HorizontalBox, ListView, SpinBox, AboutSlint, Palette, CheckBox } from "std-widgets.slint";

export struct Project { label: string, id: string, status: string, mount: string, desired: bool }
export struct BranchItem { id: string, label: string, shared: bool, current: bool }
export struct CheckpointItem { id: string, label: string }
export struct PairPeer { id: string, fingerprint: string, revoked: bool }
export struct PairRepo { id: string, label: string, replica: string, branches: string }
export struct PairGrant { peer: string, repo: string, enabled: bool, revoked: bool }

// Standard controls and custom surfaces share Slint's resolved system palette.
// Translucent Fluent controls must never sit on a fixed opposite-theme panel.
export global AppTheme {
    out property <brush> background: Palette.background;
    out property <brush> surface: Palette.alternate-background;
    out property <brush> foreground: Palette.foreground;
    out property <brush> muted: Palette.foreground.with-alpha(0.78);
    out property <brush> border: Palette.border;
}

component Caption inherits Text { color: AppTheme.muted; font-size: 13px; }
component Heading inherits Text { color: AppTheme.foreground; font-size: 26px; font-weight: 700; }
component Card inherits Rectangle {
    background: AppTheme.surface; border-color: AppTheme.border; border-width: 1px; border-radius: 12px;
}

export component App inherits Window {
    title: "Telekinesis";
    preferred-width: 1180px; preferred-height: 820px; min-width: 980px; min-height: 720px;
    background: AppTheme.background; default-font-family: "Segoe UI"; default-font-size: 14px;
    in-out property <bool> first-run;
    in-out property <int> main-page: 0;
    in-out property <string> pair-config;
    in-out property <string> pair-endpoint;
    in-out property <string> pair-token;
    in-out property <string> pair-identity;
    in-out property <string> pair-review;
    in-out property <bool> pair-ready;
    in-out property <bool> pair-confirmed;
    in-out property <bool> pair-grant-confirmed;
    in-out property <bool> pair-revoke-confirmed;
    in-out property <bool> pair-cancellable;
    in-out property <[PairPeer]> pair-peers;
    in-out property <[PairRepo]> pair-repos;
    in-out property <int> pair-selected-peer: -1;
    in-out property <int> pair-selected-repo: -1;
    in-out property <string> pair-runtime;
    in-out property <string> pair-local;
    in-out property <string> pair-syncs;
    in-out property <[PairGrant]> pair-grants;
    out property <bool> pair-peer-active: root.pair-selected-peer >= 0 && root.pair-selected-peer < root.pair-peers.length && !root.pair-peers[root.pair-selected-peer].revoked;
    out property <bool> pair-repo-selected: root.pair-peer-active && root.pair-selected-repo >= 0 && root.pair-selected-repo < root.pair-repos.length;
    callback pair-action(int);
    callback pair-cancel;
    callback pair-grant-action(int, int);
    in-out property <bool> connected;
    in-out property <bool> working;
    in-out property <bool> create-visible;
    in-out property <bool> about-visible;
    in-out property <bool> shutdown-visible;
    in-out property <bool> can-retry;
    in-out property <bool> show-activity;
    private property <bool> modal: root.create-visible || root.about-visible || root.shutdown-visible || root.branch-dialog != 0;
    out property <bool> can-start-project: root.connected && !root.working && !root.modal && root.selected >= 0 && root.selected < root.projects.length && (!root.projects[root.selected].desired || root.projects[root.selected].status == "Unavailable");
    out property <bool> can-stop-project: root.connected && !root.working && !root.modal && root.selected >= 0 && root.selected < root.projects.length && (root.projects[root.selected].desired || root.projects[root.selected].status != "Stopped");
    out property <bool> can-start-supervisor: !root.working && !root.modal && !root.first-run;
    out property <bool> can-stop-supervisor: root.connected && !root.working && !root.modal;
    in-out property <string> connection: "Connecting…";
    in-out property <string> config-path;
    in-out property <string> data-folder;
    in-out property <string> mount-folder;
    in-out property <int> worker-limit: 8;
    in-out property <[Project]> projects;
    in-out property <int> selected: -1;
    in-out property <string> project-name;
    in-out property <string> project-mount;
    in-out property <string> status-detail: "Choose a project to see its local state.";
    in-out property <string> branches-detail;
    in-out property <[BranchItem]> branches;
    in-out property <[CheckpointItem]> checkpoints;
    in-out property <int> selected-branch: -1;
    in-out property <int> selected-checkpoint: -1;
    in-out property <int> details-page: 0;
    in-out property <bool> runtime-ready;
    in-out property <string> runtime-generation;
    in-out property <string> current-branch-id;
    in-out property <string> current-branch-name;
    in-out property <bool> current-branch-shared;
    in-out property <string> branch-operation-detail;
    in-out property <bool> can-retry-branch;
    in-out property <int> branch-dialog: 0;
    in-out property <string> branch-input;
    in-out property <bool> publication-confirmed;
    in-out property <string> branch-source-project;
    in-out property <string> branch-source-active;
    in-out property <string> branch-source-generation;
    in-out property <string> branch-target-id;
    in-out property <string> branch-target-label;
    out property <bool> can-branch-actions: root.connected && root.runtime-ready && !root.working && !root.modal && !root.can-retry-branch && root.selected >= 0 && root.selected < root.projects.length;
    out property <bool> can-checkout: root.can-branch-actions && root.selected-branch >= 0 && root.selected-branch < root.branches.length && !root.branches[root.selected-branch].current;
    out property <bool> can-submit-branch: !root.working && root.branch-dialog != 0 && (root.branch-dialog == 2 || root.branch-input != "") && (root.branch-dialog != 3 || root.publication-confirmed);
    in-out property <string> message;
    in-out property <string> operation-detail;
    in-out property <bool> error;
    out property <bool> project-name-focused: project-name-edit.has-focus;
    callback setup;
    callback connect;
    callback refresh;
    callback select-project(int);
    callback create-project;
    callback start-project;
    callback stop-project;
    callback shutdown;
    callback retry;
    callback inspect-operation;
    callback browse(int);
    callback open-project;
    callback focus-project-name;
    callback submit-branch;
    callback retry-branch;
    callback begin-branch-action(int);
    callback cancel-branch-dialog;
    cancel-branch-dialog => { root.branch-dialog = 0; root.branch-input = ""; root.publication-confirmed = false; }
    begin-branch-action(kind) => {
        if root.can-branch-actions {
            root.branch-source-project = root.projects[root.selected].id;
            root.branch-source-active = root.current-branch-id;
            root.branch-source-generation = root.runtime-generation;
            root.branch-target-id = kind == 5 && root.selected-checkpoint >= 0 ? root.checkpoints[root.selected-checkpoint].id : root.selected-branch >= 0 ? root.branches[root.selected-branch].id : "";
            root.branch-target-label = kind == 5 && root.selected-checkpoint >= 0 ? root.checkpoints[root.selected-checkpoint].label : root.selected-branch >= 0 ? root.branches[root.selected-branch].label : "";
            root.branch-input = "";
            root.publication-confirmed = false;
            root.branch-dialog = kind;
        }
    }
    // App-local override used by acceptance; no Windows settings are changed.
    callback set-theme(int);
    set-theme(mode) => { Palette.color-scheme = mode == 1 ? ColorScheme.light : mode == 2 ? ColorScheme.dark : ColorScheme.unknown; }
    focus-project-name => { project-name-edit.focus(); }

    HorizontalLayout {
        spacing: 0px;
        Rectangle {
            width: 214px; background: #142e3c;
            VerticalLayout {
                padding: 24px; spacing: 18px;
                Text { text: "TK"; color: #8de0c4; font-size: 36px; font-weight: 800; }
                Text { text: "Telekinesis"; color: white; font-size: 22px; font-weight: 650; }
                Text { text: "Your projects.\nYour computer."; color: #afc4cf; font-size: 14px; }
                Rectangle { height: 1px; background: #35515f; }
                Rectangle { height: 42px; background: AppTheme.surface; border-radius: 6px; Button { text: root.first-run ? "01  Set up" : "01  Projects"; checkable: true; checked: root.main-page == 0; enabled: !root.working && !root.modal; clicked => { root.main-page = 0; } } }
                Rectangle { height: 42px; background: AppTheme.surface; border-radius: 6px; Button { text: "02  Connect a server"; checkable: true; checked: root.main-page == 1; enabled: !root.working && !root.modal; clicked => { root.main-page = 1; } } }
                Text { text: "Local workspace manager"; color: #afc4cf; font-size: 12px; wrap: word-wrap; }
                Rectangle { vertical-stretch: 1; background: transparent; }
                Text { text: "LOCAL MODE"; color: #8de0c4; font-size: 11px; font-weight: 700; }
                Text { text: "Background workers keep your projects available when you close this window."; color: #afc4cf; font-size: 13px; wrap: word-wrap; }
                Rectangle { height: 40px; background: AppTheme.surface; border-radius: 6px; HorizontalLayout { padding: 4px; Button { text: "About Telekinesis"; enabled: !root.modal; clicked => { root.about-visible = true; } } } }
                Text { text: "Made with Slint"; color: #afc4cf; font-size: 12px; }
            }
        }
        VerticalLayout {
            padding: 28px; spacing: 18px;
            HorizontalLayout {
                VerticalLayout {
                    spacing: 6px;
                    Heading { text: root.main-page == 1 ? "Connect a server" : root.first-run ? "Make room for your projects" : "Projects"; }
                    Caption { text: root.main-page == 1 ? "Pair this device for authorized published-data sync." : root.first-run ? "One portable installation, independent local workspaces." : "Manage the workspaces running on this computer."; }
                }
                Rectangle { horizontal-stretch: 1; background: transparent; }
                Button { text: root.connected ? "Refresh" : "Start / reconnect supervisor"; visible: root.main-page == 0; enabled: !root.working && !root.modal && !root.first-run; clicked => { root.connected ? root.refresh() : root.connect(); } }
                Button { text: "+ New project"; primary: true; enabled: root.connected && !root.working && !root.modal; visible: !root.first-run && root.main-page == 0; clicked => { root.create-visible = true; root.project-name = ""; root.project-mount = ""; root.focus-project-name(); } }
            }
            if root.main-page == 0: Card {
                height: 54px;
                HorizontalLayout {
                    padding: 16px; spacing: 12px;
                    Rectangle { width: 9px; height: 9px; border-radius: 5px; background: root.connected ? #239675 : #c18c3f; }
                    Text { text: root.connection; color: AppTheme.foreground; vertical-alignment: center; overflow: elide; }
                    Rectangle { horizontal-stretch: 1; background: transparent; }
                    Caption { text: root.working ? "Working…" : "Local only"; vertical-alignment: center; }
                }
            }
            if root.first-run && root.main-page == 0: Card {
                VerticalLayout {
                    padding: 26px; spacing: 16px;
                    Text { text: "Choose two separate folders"; color: AppTheme.foreground; font-size: 19px; font-weight: 600; }
                    Caption { text: "Native data holds the catalog and durable history. Project folders contain the mounted views you use in Explorer."; wrap: word-wrap; }
                    Text { text: "Native data folder (new or empty)"; color: AppTheme.foreground; }
                    HorizontalLayout { LineEdit { accessible-label: "Native data folder"; text <=> root.data-folder; enabled: !root.working && !root.modal; } Button { text: "Browse…"; enabled: !root.working && !root.modal; clicked => { root.browse(0); } } }
                    Text { text: "Parent folder for project mounts"; color: AppTheme.foreground; }
                    HorizontalLayout { LineEdit { accessible-label: "Project mount parent folder"; text <=> root.mount-folder; enabled: !root.working && !root.modal; } Button { text: "Browse…"; enabled: !root.working && !root.modal; clicked => { root.browse(1); } } }
                    HorizontalLayout { Text { text: "Maximum running projects"; color: AppTheme.foreground; vertical-alignment: center; } SpinBox { value <=> root.worker-limit; minimum: 1; maximum: 64; enabled: !root.working && !root.modal; } Rectangle { horizontal-stretch: 1; } }
                    Rectangle { height: 1px; background: AppTheme.border; }
                    Caption { text: "Configuration is saved beside this application:"; }
                    Text { text: root.config-path; color: AppTheme.foreground; wrap: word-wrap; font-size: 12px; }
                    Caption { text: "Mounting requires the installed WinFsp runtime. No network connection or service is configured."; wrap: word-wrap; }
                    HorizontalLayout { Rectangle { horizontal-stretch: 1; } Button { text: "Save and connect"; primary: true; enabled: !root.working && !root.modal; clicked => { root.setup(); } } }
                    Rectangle { vertical-stretch: 1; }
                }
            }
            if root.main-page == 1: Card {
                ScrollView {
                    VerticalLayout { padding: 22px; spacing: 14px;
                        Text { text: "1  Protect this device's identity"; color: AppTheme.foreground; font-size: 19px; font-weight: 600; }
                        Caption { text: "Create an outbound-only client, or load an existing client config. Keys are protected by Windows CurrentUser DPAPI; config stores only the credential reference. No listener or service is installed."; wrap: word-wrap; }
                        LineEdit { accessible-label: "Pairing configuration path"; text <=> root.pair-config; enabled: !root.working; }
                        HorizontalLayout {
                            Button { text: "Create protected client"; enabled: !root.working; clicked => { root.pair-action(1); } }
                            Button { text: "Load / refresh client"; enabled: !root.working; clicked => { root.pair-confirmed = false; root.pair-action(0); } }
                        }
                        Text { text: root.pair-identity; color: AppTheme.foreground; wrap: word-wrap; font-size: 12px; }
                        Rectangle { height: 1px; background: AppTheme.border; }
                        Text { text: "2  Review the server invitation"; color: AppTheme.foreground; font-size: 19px; font-weight: 600; }
                        Caption { text: "Use the server's numeric WSS address and /tkfs/sync path. Paste the one-time invitation privately; it is cleared from the input when inspected and never saved. WSS is required; no downgrade is offered."; wrap: word-wrap; }
                        LineEdit { accessible-label: "Server WSS sync endpoint"; placeholder-text: "wss://192.0.2.1:8443/tkfs/sync"; text <=> root.pair-endpoint; enabled: root.pair-ready && !root.working; }
                        LineEdit { accessible-label: "Secret one-time invitation"; input-type: password; placeholder-text: "Paste invitation privately"; text <=> root.pair-token; enabled: root.pair-ready && !root.working; }
                        HorizontalLayout {
                            Button { text: "Inspect invitation"; enabled: root.pair-ready && !root.working && root.pair-token != ""; clicked => { root.pair-action(2); } }
                            Button { text: "Discard invitation"; enabled: !root.working && (root.pair-token != "" || root.pair-review != ""); clicked => { root.pair-action(10); } }
                        }
                        Text { text: root.pair-review; color: AppTheme.foreground; wrap: word-wrap; font-size: 12px; }
                        CheckBox { text: "I verified the server's exact certificate fingerprint with its owner"; checked <=> root.pair-confirmed; enabled: root.pair-review != "" && !root.working; }
                        Button { text: "Enroll this device"; primary: true; enabled: root.pair-ready && root.pair-review != "" && root.pair-confirmed && !root.working; clicked => { root.pair-action(3); } }
                        Rectangle { height: 1px; background: AppTheme.border; }
                        Text { text: "3  Wait for local approval on the server"; color: AppTheme.foreground; font-size: 19px; font-weight: 600; }
                        Caption { text: "Give the server owner your installation ID and certificate fingerprint shown above. They must approve that exact key locally, then grant a published repository to your replica. This client cannot approve itself or administer the server."; wrap: word-wrap; }
                        for peer[index] in root.pair-peers: VerticalLayout {
                            Button { text: peer.id + (peer.revoked ? " · Revoked" : " · Locally trusted key"); checkable: true; checked: root.pair-selected-peer == index; enabled: !root.working; clicked => { root.pair-selected-peer = index; root.pair-action(11); } }
                            Caption { text: "SHA-256: " + peer.fingerprint; wrap: word-wrap; font-size: 12px; }
                        }
                        Button { text: "Check approval / load published repositories"; enabled: root.pair-ready && root.pair-peer-active && !root.working; clicked => { root.pair-action(4); } }
                        Rectangle { height: 1px; background: AppTheme.border; }
                        Text { text: "4  Configure a matching local replica"; color: AppTheme.foreground; font-size: 19px; font-weight: 600; }
                        for repo[index] in root.pair-repos: VerticalLayout {
                            Button { text: repo.label + " · " + repo.id; checkable: true; checked: root.pair-selected-repo == index; enabled: !root.working; clicked => { root.pair-selected-repo = index; root.pair-grant-confirmed = false; } }
                            Caption { text: "Published branches (all are synchronized):\n" + repo.branches; wrap: word-wrap; font-size: 12px; }
                        }
                        Caption { text: "A running replica with the same repository ID and a different device ID is required. Select its native runtime.json. New replica provisioning/adoption is not supported by this screen. Mounting is configured on that local worker; sync leaves its current branch selected. Choose the local view in Branches & snapshots or the CLI."; wrap: word-wrap; }
                        LineEdit { accessible-label: "Matching local replica runtime discovery path"; placeholder-text: "C:\\path\\to\\replica\\runtime.json"; text <=> root.pair-runtime; enabled: !root.working; }
                        CheckBox { text: "Enable bidirectional sync for all published branches in this repository"; checked <=> root.pair-grant-confirmed; enabled: root.pair-repo-selected && !root.working; }
                        Button { text: "Configure published-data sync"; enabled: root.pair-repo-selected && root.pair-runtime != "" && root.pair-grant-confirmed && !root.working; clicked => { root.pair-action(5); } }
                        Text { text: root.pair-local; color: AppTheme.foreground; wrap: word-wrap; font-size: 12px; }
                        HorizontalLayout {
                            Button { text: "Sync now / next page"; enabled: root.pair-ready && root.pair-repo-selected && !root.working; clicked => { root.pair-action(6); } }
                            Button { text: "Pause sync"; enabled: root.pair-repo-selected && !root.working; clicked => { root.pair-action(7); } }
                            Button { text: "Resume sync grant"; enabled: root.pair-repo-selected && !root.working; clicked => { root.pair-action(8); } }
                        }
                        Caption { text: "Private branches and deleted private history stay local. Cancel stops local I/O; it does not undo enrollment or committed sync data. An uncertain enrollment may require a fresh invitation. No background sync service is started by this flow."; wrap: word-wrap; }
                        Button { text: "Cancel current network operation"; enabled: root.working && root.pair-cancellable; clicked => { root.pair-cancel(); } }
                        Text { text: root.pair-syncs; color: AppTheme.foreground; wrap: word-wrap; font-size: 12px; }
                        for grant[index] in root.pair-grants: VerticalLayout {
                            Caption { text: "Configured repository: " + grant.repo + (grant.revoked ? " · Revoked" : grant.enabled ? " · Enabled" : " · Paused"); wrap: word-wrap; }
                            HorizontalLayout {
                                Button { text: "Sync configured repository"; enabled: root.pair-ready && grant.enabled && !grant.revoked && !root.working; clicked => { root.pair-grant-action(index, 0); } }
                                Button { text: grant.enabled ? "Pause" : "Resume"; enabled: !grant.revoked && !root.working; clicked => { root.pair-grant-action(index, grant.enabled ? 1 : 2); } }
                            }
                        }
                        CheckBox { text: "I understand revocation is local and cannot be undone with Resume"; checked <=> root.pair-revoke-confirmed; enabled: root.pair-peer-active && !root.working; }
                        Button { text: "Revoke selected peer locally"; enabled: root.pair-peer-active && root.pair-revoke-confirmed && !root.working; clicked => { root.pair-action(9); } }
                    }
                }
            }
            if !root.first-run && root.main-page == 0: HorizontalLayout {
                spacing: 18px;
                Card {
                    width: 240px;
                    VerticalLayout {
                        padding: 16px; spacing: 12px;
                        Text { text: "WORKSPACES"; color: AppTheme.muted; font-size: 11px; font-weight: 700; }
                        if root.projects.length == 0: VerticalLayout {
                            spacing: 12px;
                            Text { text: root.connected ? "Your first project starts here" : "Projects are unavailable"; color: AppTheme.foreground; font-size: 19px; font-weight: 600; wrap: word-wrap; }
                            Caption { text: root.connected ? "Create a project and choose its mount folder. Its history stays in your native data folder." : "Reconnect to load the catalog. Existing project data is preserved."; wrap: word-wrap; }
                            Rectangle { vertical-stretch: 1; }
                        }
                        if root.projects.length > 0: ListView {
                            for project[index] in root.projects: VerticalLayout {
                                padding-bottom: 9px; spacing: 3px;
                                Button { text: project.label; checkable: true; checked: root.selected == index; enabled: !root.working && !root.modal; clicked => { root.select-project(index); } }
                                Caption { text: project.status; font-size: 12px; }
                            }
                        }
                    }
                }
                Card {
                    VerticalLayout {
                        padding: 22px; spacing: 14px;
                        Text { text: root.selected >= 0 && root.selected < root.projects.length ? root.projects[root.selected].label : "Project details"; color: AppTheme.foreground; font-size: 22px; font-weight: 600; }
                        if root.selected >= 0 && root.selected < root.projects.length: HorizontalLayout {
                            Button { text: "Open folder"; enabled: root.connected && !root.working && !root.modal && (root.projects[root.selected].status == "Running" || root.projects[root.selected].status == "Needs attention" || root.projects[root.selected].status == "Stopping · files in use") && root.projects[root.selected].mount != ""; clicked => { root.open-project(); } }
                            Button { text: "Start project"; enabled: root.can-start-project; clicked => { root.start-project(); } }
                            Button { text: "Stop project"; enabled: root.can-stop-project; clicked => { root.stop-project(); } }
                        }
                        if root.selected >= 0: HorizontalLayout {
                            Button { text: "Overview"; checkable: true; checked: root.details-page == 0; enabled: !root.modal; clicked => { root.details-page = 0; } }
                            Button { text: "Branches & snapshots"; checkable: true; checked: root.details-page == 1; enabled: !root.modal; clicked => { root.details-page = 1; } }
                        }
                        if root.details-page == 0: ScrollView { VerticalLayout {
                            spacing: 16px;
                            Text { text: root.status-detail; color: AppTheme.foreground; wrap: word-wrap; font-size: 13px; }
                            Text { text: root.branches-detail; color: AppTheme.foreground; wrap: word-wrap; font-size: 13px; }
                            Rectangle { vertical-stretch: 1; }
                        } }
                        if root.details-page == 1: ScrollView { VerticalLayout {
                            spacing: 12px;
                            Text { text: root.runtime-ready ? "Current: " + root.current-branch-name : "Branch controls unavailable"; color: AppTheme.foreground; font-size: 17px; font-weight: 600; wrap: word-wrap; }
                            Caption { text: root.runtime-ready ? (root.current-branch-shared ? "Shared branch · sync requires a published-data grant" : "Private branch · stays on this computer") : "Start the project, then refresh. Sampled or unavailable runtime state cannot authorize branch actions."; wrap: word-wrap; }
                            HorizontalLayout {
                                Button { text: "New private branch…"; enabled: root.can-branch-actions; clicked => { root.begin-branch-action(1); } }
                                Button { text: "Switch to selected…"; enabled: root.can-checkout; clicked => { root.begin-branch-action(2); } }
                            }
                            ListView { height: min(180px, max(95px, root.branches.length * 52px));
                                for branch[index] in root.branches: VerticalLayout { spacing: 3px; padding-bottom: 7px;
                                    Button { text: branch.label + (branch.shared ? " · Shared" : " · Private") + (branch.current ? " · Current" : ""); checkable: true; checked: root.selected-branch == index; enabled: !root.working && !root.modal; clicked => { root.selected-branch = index; } }
                                    Caption { text: branch.shared ? "Shared · published-data grants apply" : "Private · local only"; }
                                }
                            }
                            Button { text: "Publish current visible state…"; enabled: root.can-branch-actions; clicked => { root.begin-branch-action(3); } }
                            Caption { text: "Publication creates a new shared branch. It does not publish private history or configure a peer."; wrap: word-wrap; }
                            Rectangle { height: 1px; background: AppTheme.border; }
                            Text { text: "Snapshots"; color: AppTheme.foreground; font-size: 17px; font-weight: 600; }
                            HorizontalLayout {
                                Button { text: "Save checkpoint…"; enabled: root.can-branch-actions; clicked => { root.begin-branch-action(4); } }
                                Button { text: "Restore to private branch…"; enabled: root.can-branch-actions && root.selected-checkpoint >= 0; clicked => { root.begin-branch-action(5); } }
                            }
                            if root.checkpoints.length == 0: Caption { text: "No checkpoints in this project yet."; }
                            if root.checkpoints.length > 0: ListView { min-height: 75px; max-height: 140px;
                                for checkpoint[index] in root.checkpoints: Button { text: checkpoint.label; checkable: true; checked: root.selected-checkpoint == index; enabled: !root.working && !root.modal; clicked => { root.selected-checkpoint = index; } }
                            }
                        } }
                    }
                }
            }
            if root.message != "": Rectangle {
                background: root.error ? #fff0e9 : #e7f4ef; border-radius: 8px;
                min-height: 56px;
                HorizontalLayout { padding: 13px; spacing: 10px;
                    Text { text: root.message; color: root.error ? #8c4028 : #23654e; wrap: word-wrap; font-size: 13px; }
                    Button { text: "Retry exact request"; visible: root.can-retry; enabled: !root.working && !root.modal && root.connected; clicked => { root.retry(); } }
                }
            }
            if root.operation-detail != "" && (root.can-retry || root.show-activity): Card {
                max-height: 120px; min-height: 65px;
                HorizontalLayout { padding: 12px; spacing: 10px;
                    ScrollView { Text { text: root.operation-detail; color: AppTheme.muted; font-size: 12px; wrap: word-wrap; } }
                    Button { text: "Inspect operation"; enabled: !root.working && !root.modal && root.connected; clicked => { root.inspect-operation(); } }
                }
            }
            if root.branch-operation-detail != "" && (root.can-retry-branch || root.show-activity): Card {
                max-height: 90px; min-height: 60px;
                HorizontalLayout { padding: 12px; spacing: 10px;
                    ScrollView { Text { text: root.branch-operation-detail; color: AppTheme.muted; font-size: 12px; wrap: word-wrap; } }
                    Button { text: "Retry original branch request"; visible: root.can-retry-branch; enabled: !root.working && !root.modal && root.connected; clicked => { root.retry-branch(); } }
                }
            }
            if !root.first-run: HorizontalLayout {
                Caption { text: "Closing this window keeps your projects running."; wrap: word-wrap; horizontal-stretch: 1; }
                Rectangle { horizontal-stretch: 1; }
                Button { text: root.show-activity ? "Hide activity" : "Activity"; enabled: !root.modal; clicked => { root.show-activity = !root.show-activity; } }
                Button { text: "Reconnect supervisor"; visible: root.connected; enabled: root.can-start-supervisor; clicked => { root.connect(); } }
                Button { text: "Shut down supervisor…"; enabled: root.can-stop-supervisor; clicked => { root.shutdown-visible = true; } }
            }
        }
    }
    Rectangle {
        visible: root.create-visible;
        background: #142e3c99;
        Card { x: (parent.width - self.width)/2; y: (parent.height - self.height)/2; width: 620px; height: 390px;
            VerticalLayout { padding: 26px; spacing: 15px;
                Heading { text: "New project"; }
                Caption { text: "Creates a new independent local store and starts its worker."; wrap: word-wrap; }
                Text { text: "Project name"; color: AppTheme.foreground; }
                project-name-edit := LineEdit { accessible-label: "Project name"; text <=> root.project-name; placeholder-text: "My project"; enabled: !root.working; }
                Text { text: "Mount path (a new folder, with an existing parent)"; color: AppTheme.foreground; }
                HorizontalLayout { LineEdit { accessible-label: "Project mount path"; text <=> root.project-mount; placeholder-text: "Leave blank to use the default parent + project name"; enabled: !root.working; } Button { text: "Parent…"; enabled: !root.working; clicked => { root.browse(2); } } }
                Caption { text: "The final mount folder must not already exist. Native data remains separate."; wrap: word-wrap; }
                Rectangle { vertical-stretch: 1; }
                HorizontalLayout { Rectangle { horizontal-stretch: 1; } Button { text: "Cancel"; enabled: !root.working; clicked => { root.create-visible = false; } } Button { text: "Create and mount"; primary: true; enabled: !root.working && root.project-name != ""; clicked => { root.create-visible = false; root.create-project(); } } }
            }
        }
    }
    if root.shutdown-visible: Rectangle {
        background: #142e3c99;
        Card { x: (parent.width - self.width)/2; y: (parent.height - self.height)/2; width: 570px; height: 250px;
            VerticalLayout { padding: 26px; spacing: 16px;
                Heading { text: "Shut down background workers?"; font-size: 23px; }
                Caption { text: "All projects in this installation will be unmounted. Close editors and Explorer windows using these projects first. Projects marked to run will return on the next supervisor launch."; wrap: word-wrap; }
                Rectangle { vertical-stretch: 1; }
                HorizontalLayout { Rectangle { horizontal-stretch: 1; } Button { text: "Keep running"; clicked => { root.shutdown-visible = false; } } Button { text: "Shut down"; clicked => { root.shutdown-visible = false; root.shutdown(); } } }
            }
        }
    }
    if root.branch-dialog != 0: Rectangle {
        background: #142e3c99;
        Card { x: (parent.width - self.width)/2; y: (parent.height - self.height)/2; width: 610px; height: 410px;
            VerticalLayout { padding: 26px; spacing: 15px;
                Heading { font-size: 23px; text: root.branch-dialog == 1 ? "New private branch" : root.branch-dialog == 2 ? "Switch branch" : root.branch-dialog == 3 ? "Publish visible state" : root.branch-dialog == 4 ? "Save checkpoint" : "Restore to private branch"; }
                Caption { text: "Project: " + (root.selected >= 0 ? root.projects[root.selected].label : "") + " · Current branch: " + root.current-branch-name; wrap: word-wrap; }
                Caption { text: root.branch-dialog == 1 ? "Copies the current visible files into a new private branch. The current branch stays selected." : root.branch-dialog == 2 ? "Switch to " + root.branch-target-label + ". Close files, editors, and Explorer windows using this project first. The mounted view is rebound only after the runtime's busy checks pass." : root.branch-dialog == 3 ? "Creates a NEW shared branch from the visible files only. Private history, deleted private content, and private conflict alternatives remain on this computer. Shared branches may synchronize when a published-data grant is enabled." : root.branch-dialog == 4 ? "Saves a local checkpoint of the current visible files. It does not switch branches or upload anything." : "Restores " + root.branch-target-label + " into a NEW private branch. Current files and the active branch stay unchanged; switch to the restored branch when ready."; wrap: word-wrap; }
                if root.branch-dialog != 2: VerticalLayout {
                    Text { text: root.branch-dialog == 4 ? "Checkpoint message" : "New branch name"; color: AppTheme.foreground; }
                    LineEdit { accessible-label: root.branch-dialog == 4 ? "Checkpoint message" : "New branch name"; text <=> root.branch-input; enabled: !root.working; }
                }
                if root.branch-dialog == 3: CheckBox { text: "I confirm publication of the current visible state only"; checked <=> root.publication-confirmed; enabled: !root.working; }
                Rectangle { vertical-stretch: 1; }
                HorizontalLayout {
                    Button { text: "Cancel"; enabled: !root.working; clicked => { root.cancel-branch-dialog(); } }
                    Rectangle { horizontal-stretch: 1; }
                    Button { text: root.branch-dialog == 2 ? "Switch branch" : root.branch-dialog == 3 ? "Publish visible state" : root.branch-dialog == 4 ? "Save checkpoint" : "Create private branch"; primary: true; enabled: root.can-submit-branch; clicked => { root.submit-branch(); } }
                }
            }
        }
    }
    if root.about-visible: Rectangle {
        background: #142e3c99;
        Card { x: (parent.width - self.width)/2; y: (parent.height - self.height)/2; width: 610px; height: 430px;
            VerticalLayout { padding: 26px; spacing: 14px;
                Heading { text: "Telekinesis 0.1.0"; }
                Caption { text: "Experimental Windows local filesystem manager. One application executable; isolated supervisor and worker processes. WinFsp is required for mounted projects."; wrap: word-wrap; }
                AboutSlint { height: 105px; }
                Caption { text: "Slint 1.17.0 uses the Royalty-free Desktop, Mobile, and Web Applications License 2.0 with AboutSlint attribution. This does not impose GPL on your own application code. This repository already declares GPL-3.0-or-later independently. See the bundled license texts and THIRD-PARTY-NOTICES.md."; wrap: word-wrap; }
                Caption { text: "Local projects and guided outbound WSS pairing are supported. Replica provisioning/adoption, trash, and Windows service setup are deferred."; wrap: word-wrap; }
                HorizontalLayout { Rectangle { horizontal-stretch: 1; } Button { text: "Close"; clicked => { root.about-visible = false; } } }
            }
        }
    }
}
